# ─────────────────────────────────────────────
# OrganicKart — root .gitignore
# ─────────────────────────────────────────────

# Local environment files (real secrets — never commit)
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# SQLite local/test databases (services use MySQL in production)
*.db
*.sqlite
*.sqlite3

# ── Frontend ──────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/src.zip

# ── Logs ──────────────────────────────────────
*.log
.run-logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build / generated archives ────────────────
*.zip
*.tar.gz
*.egg-info/
dist/
build/

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
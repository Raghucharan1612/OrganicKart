SERVICE_NAME=ai-service
SERVICE_PORT=8002

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_PREDICT=250
MOCK_LLM=false

# Brave Search API is used only for general/current questions. Keep the key server-side.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=5
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_BRAVE_URL=https://api.search.brave.com/res/v1/web/search

JWT_SECRET_KEY=replace-me-with-a-secure-secret
JWT_ALGORITHM=HS256
